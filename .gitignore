# Source-only repository: data, numerical arrays, figures and runtime products stay local.
# Traverse only the four maintained trees; files are ignored unless allowed below.
*
!/notes/**/
!/scripts/**/
!/src/**/
!/test/**/

# Source code, configuration and research documentation.
!*.py
!*.pyx
!*.pxd
!*.sh
!*.c
!*.h
!*.cpp
!*.hpp
!*.f
!*.f90
!*.md
!*.rst
!*.ipynb
!*.yaml
!*.yml
!*.toml
!*.ini
!*.cfg
!*.tex
!*.bib
!*.sty
!*.cls
!*.mplstyle
!Makefile
!CMakeLists.txt
!requirements*.txt
!.latexmkrc
!.gitignore
!**/config/*.json
!**/config.json
!**/*_config.json

# JSON research/configuration records (not general JSON result files).
!/test/Temperature_mapping/**/outputs/lag_run_contract.json
!/test/Temperature_mapping/sample10/physical_parameters.json
!/test/mica_slowgp/staged_importance*/settings.json
!/test/mica_slowgp/staged_importance*/computation-record.json
!/test/mica_slowgp/staged_importance*/independent_review.json
!/test/mica_slowgp/small_budget.json
!/test/mica_slowgp/qmc_prefix_budget_plan.json
!/test/mica_smooth/cases_highpass*/*/manifest.json
!/test/mica_recovery/longterm_test/**/provenance.json
!/test/mica_recovery/longterm_test/cases*/manifest.json
!/test/mica_recovery/longterm_test/predict/prediction_candidates.json

# Native MICA settings use extensionless files and one TXT prior definition.
!/test/mica_joint/figures_20260909/native/*/param/OPTIONS1D
!/test/mica_joint/figures_20260909/native/*/param/param_input
!/test/mica_joint/figures_20260909/native/joint/param/joint_parameter_priors.txt

# Keep the repository root bounded to the existing public entrypoints and trees.
/*
!/.gitignore
!/main.py
!/joint_hubble_config.yaml
!/notes/
!/scripts/
!/src/
!/test/

# Do not collect source-format files inside caches or third-party environments.
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.mplconfig/
**/tex.cache/
**/.venv/
**/venv/
**/site-packages/
**/node_modules/
**/*.orig
**/*:Zone.Identifier
/test/Temperature_mapping/outputs/lag_env/
/test/Temperature_mapping/outputs/lag_vendor/
